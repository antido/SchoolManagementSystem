APP_NAME="School Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database: create an empty MySQL database first, then fill these in.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=school_management_system
DB_USERNAME=root
DB_PASSWORD=

# Sessions. In production also set SESSION_SECURE_COOKIE=true (HTTPS only).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Uploaded files. "local" keeps them private (storage/app/private);
# "public" is only used for images that anyone may see.
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail. "log" writes emails to storage/logs/laravel.log instead of sending them.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# School settings (see config/school.php and docs/guide/installation.md).
# Let people create their own account at /register (off: the school creates accounts).
SCHOOL_REGISTRATION_ENABLED=false
# Let guests read the FAQ without signing in.
SCHOOL_FAQ_PUBLIC=true
# Where uploaded files go (a private disk) and the largest file allowed, in KB.
SCHOOL_ATTACHMENTS_DISK=local
SCHOOL_ATTACHMENT_MAX_KB=10240
# Record IP addresses in the audit trail (only if your privacy policy says so).
SCHOOL_AUDIT_STORE_IP=false
# Log queries slower than this many milliseconds (0 turns it off).
SCHOOL_SLOW_QUERY_MS=500

# Realtime notifications (optional). Set SCHOOL_REALTIME=true and
# BROADCAST_CONNECTION=reverb, fill in the keys, and run php artisan reverb:start.
SCHOOL_REALTIME=false
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
